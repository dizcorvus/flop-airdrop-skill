# ==============================================================================
# FLOP Airdrop Skill & Technocore Environment Configuration Template
# Copy this file to .env or let 'python scripts/agent_toolkit.py init' generate it.
# ==============================================================================

# Your public Ed25519 DID string (generated automatically)
TECHNOCORE_DID=did:key:z6Mk...

# The 32-character passphrase protecting your local identity.pem key file
TECHNOCORE_PASSPHRASE=your-strong-passphrase-here-32chars

# Technocore official HTTP endpoint
TECHNOCORE_BASE_URL=https://technocore.chat
